{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?__p=/" },
    { "source": "/api/(.*)", "destination": "/api/index?__p=/api/$1" },
    { "source": "/(.*)", "destination": "/api/index?__p=/$1" }
  ]
}
